# Copy this file to .env and fill it in. Never share or commit your real .env.

# --- Confirmation codes (OTP) ---
# A long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
OTP_SECRET=change-me-to-a-long-random-string

# SMS via Twilio (use TWILIO_FROM *or* TWILIO_MESSAGING_SERVICE_SID)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1xxxxxxxxxx
# TWILIO_MESSAGING_SERVICE_SID=

# Email via Resend (the sending domain/address must be verified in your Resend account)
# RESEND_API_KEY=
# EMAIL_FROM=CareerConnect SA <no-reply@yourdomain.co.za>

# Set to production when live. Then codes are NEVER printed to the terminal and
# sending fails unless a provider above is configured.
# NODE_ENV=production

# --- Document reading (AI) ---
ANTHROPIC_API_KEY=paste-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-5-5

# If your PAGE is on GitHub Pages but this SERVER is hosted elsewhere, list the page's address here
# (just the site address, no path), then set API_BASE in index.html to this server's address.
# ALLOWED_ORIGIN=https://yourname.github.io

# PORT=3000
